# Copy to .env for local development. Never commit .env.

# "mock" (demo sign-in, refuses NODE_ENV=production) or "oidc"
AUTH_MODE=mock
# Signs session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-long-random-string
# Public base URL of the app (used by Auth.js callbacks)
AUTH_URL=http://localhost:3000

# SQLite for local dev. Production: postgresql://user:password@host:5432/keystone
DATABASE_URL=file:./dev.db

# OIDC (AUTH_MODE=oidc). Okta, Entra ID, Google Workspace or the local Keycloak.
# Local Keycloak (docker compose up -d keycloak): issuer
# http://localhost:8080/realms/keystone, client keystone, secret keystone-dev-secret.
OIDC_ISSUER=https://your-idp.example.com
OIDC_CLIENT_ID=replace-me
OIDC_CLIENT_SECRET=replace-me
OIDC_GROUPS_CLAIM=groups
# Optional. Default "openid profile email". Okta: "openid profile email groups".
OIDC_SCOPES=

# Shown in the top bar as the environment badge (DEMO, STAGING, PROD)
KEYSTONE_ENV_LABEL=DEMO

# Optional Slack incoming webhook for approval notifications. Unset = in-app only.
SLACK_WEBHOOK_URL=

# Fake payments: fraction of refund calls that fail (0 to 1)
FAKE_PAYMENTS_FAIL_RATE=0

# Devin API for "Build with Devin". Server-side only: never sent to the
# browser or logged. Leave as replace-me (or empty) for simulation mode, which
# shows the exact API request instead of starting a session.
# Use a Devin service-user key (Member role is enough).
DEVIN_API_KEY=replace-me
DEVIN_ORG_ID=replace-me
# Repo Devin works in, as owner/name
DEVIN_REPO=your-org/keystone-internal-tools
# Max ACUs a single request's session may use
DEVIN_MAX_ACU=10
# Your price per ACU in USD, for /build/impact (leave empty to hide cost)
DEVIN_ACU_PRICE=
# Power Apps Premium price per user per month in USD, for the comparison on /build/impact
POWERAPPS_SEAT_PRICE=22
