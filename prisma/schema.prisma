// SQLite for local dev, Postgres in production (change `provider`).
// SQLite has no enums or JSON columns in Prisma: statuses are strings
// validated with zod, and JSON is stored as text.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  subject     String    @unique
  email       String
  name        String
  groups      String // JSON string[] of IdP groups, refreshed every sign-in
  roles       String // JSON string[] of app roles, recomputed every sign-in
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Append-only. No update or delete exists in code.
// Production: REVOKE UPDATE, DELETE ON "AuditEvent" FROM <app role>.
model AuditEvent {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  actorId    String
  actorName  String
  actorRoles String // JSON string[]
  tool       String
  action     String
  entityType String
  entityId   String
  before     String? // JSON
  after      String? // JSON
  requestId  String?

  @@index([entityType, entityId, createdAt])
  @@index([tool, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model ApprovalRequest {
  id                String    @id @default(cuid())
  tool              String
  actionType        String
  entityType        String
  entityId          String
  payload           String // JSON
  amountCents       Int?
  status            String    @default("pending") // pending | approved | rejected | executed | failed
  requestedById     String
  requestedByName   String
  decidedById       String?
  decidedByName     String?
  decidedAt         DateTime?
  reason            String?
  approvePermission String
  idempotencyKey    String    @unique
  attempts          Int       @default(0)
  result            String? // JSON
  lastError         String?
  executedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([requestedById, createdAt])
  @@index([tool, entityType, entityId])
}

model Customer {
  id           String            @id
  name         String
  email        String
  phone        String
  country      String
  status       String // active | restricted | closed
  riskTier     String // low | medium | high
  createdAt    DateTime
  transactions CardTransaction[]

  @@index([email])
  @@index([createdAt])
}

model CardTransaction {
  id            String   @id
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  amountCents   Int
  refundedCents Int      @default(0)
  currency      String   @default("USD")
  merchant      String
  category      String
  cardLast4     String
  status        String // settled | pending | declined | refunded
  createdAt     DateTime

  @@index([customerId, createdAt])
  @@index([createdAt])
  @@index([status, createdAt])
}

// Refunds tool. One refund per card transaction. Refunds over the tool's
// threshold get an ApprovalRequest (entityType "Refund"); while one exists,
// its status is the source of truth for the refund's status.
model Refund {
  id                String    @id @default(cuid())
  transactionId     String    @unique
  customerId        String
  amountCents       Int
  currency          String    @default("USD")
  reason            String // duplicate_charge | product_not_received | service_issue | fraud | other
  note              String?
  status            String // pending_approval | executed | failed (approval path: see ApprovalRequest)
  requiresApproval  Boolean
  approvalRequestId String?   @unique
  idempotencyKey    String    @unique
  paymentRefundId   String?
  attempts          Int       @default(0)
  lastError         String?
  requestedById     String
  requestedByName   String
  executedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([createdAt])
  @@index([amountCents])
}
