// SQLite for local dev, Postgres in production (change `provider`).
// SQLite has no enums or JSON columns in Prisma: statuses are strings
// validated with zod, and JSON is stored as text.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  subject     String    @unique
  email       String
  name        String
  groups      String // JSON string[] of IdP groups, refreshed every sign-in
  roles       String // JSON string[] of app roles, recomputed every sign-in
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Append-only. No update or delete exists in code.
// Production: REVOKE UPDATE, DELETE ON "AuditEvent" FROM <app role>.
model AuditEvent {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  actorId    String
  actorName  String
  actorRoles String // JSON string[]
  tool       String
  action     String
  entityType String
  entityId   String
  before     String? // JSON
  after      String? // JSON
  requestId  String?

  @@index([entityType, entityId, createdAt])
  @@index([tool, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model ApprovalRequest {
  id                String    @id @default(cuid())
  tool              String
  actionType        String
  entityType        String
  entityId          String
  payload           String // JSON
  amountCents       Int?
  status            String    @default("pending") // pending | approved | rejected | executed | failed
  requestedById     String
  requestedByName   String
  decidedById       String?
  decidedByName     String?
  decidedAt         DateTime?
  reason            String?
  approvePermission String
  idempotencyKey    String    @unique
  attempts          Int       @default(0)
  result            String? // JSON
  lastError         String?
  executedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([requestedById, createdAt])
  @@index([tool, entityType, entityId])
}

model Customer {
  id           String            @id
  name         String
  email        String
  phone        String
  country      String
  status       String // active | restricted | closed
  riskTier     String // low | medium | high
  createdAt    DateTime
  transactions CardTransaction[]

  @@index([email])
  @@index([createdAt])
}

model CardTransaction {
  id            String   @id
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  amountCents   Int
  refundedCents Int      @default(0)
  currency      String   @default("USD")
  merchant      String
  category      String
  cardLast4     String
  status        String // settled | pending | declined | refunded
  createdAt     DateTime

  @@index([customerId, createdAt])
  @@index([createdAt])
  @@index([status, createdAt])
}

// Refunds tool. One refund per card transaction. Refunds over the tool's
// threshold get an ApprovalRequest (entityType "Refund"); while one exists,
// its status is the source of truth for the refund's status.
model Refund {
  id                String    @id @default(cuid())
  transactionId     String    @unique
  customerId        String
  amountCents       Int
  currency          String    @default("USD")
  reason            String // duplicate_charge | product_not_received | service_issue | fraud | other
  note              String?
  status            String // pending_approval | executed | failed (approval path: see ApprovalRequest)
  requiresApproval  Boolean
  approvalRequestId String?   @unique
  idempotencyKey    String    @unique
  paymentRefundId   String?
  attempts          Int       @default(0)
  lastError         String?
  requestedById     String
  requestedByName   String
  executedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([createdAt])
  @@index([amountCents])
}

// In-app notifications (one row per recipient) and outbound Slack messages
// (channel "slack", no recipient). In-app rows are written in the same
// transaction as the action that caused them; Slack rows are delivered only
// after that transaction commits, and a delivery failure never affects it.
model Notification {
  id             String    @id @default(cuid())
  channel        String // in_app | slack
  userId         String? // recipient for in_app; null for slack
  kind           String // approval.requested | approval.decided | approval.failed
  title          String
  body           String?
  href           String?
  readAt         DateTime?
  deliveryStatus String? // slack only: pending | sending | sent | failed
  deliveryError  String?
  createdAt      DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@index([channel, deliveryStatus, createdAt])
}

// Periodic user access reviews (SOC 2 / sponsor-bank evidence).
// A review snapshots every user's groups and roles when it starts; reviewers
// mark each one keep or revoke. Completed reviews are read-only.
model AccessReview {
  id              String             @id @default(cuid())
  name            String
  status          String             @default("in_progress") // in_progress | completed
  startedById     String
  startedByName   String
  startedAt       DateTime           @default(now())
  completedById   String?
  completedByName String?
  completedAt     DateTime?
  items           AccessReviewItem[]

  @@index([status, startedAt])
}

model AccessReviewItem {
  id            String       @id @default(cuid())
  reviewId      String
  review        AccessReview @relation(fields: [reviewId], references: [id])
  userId        String
  userName      String
  userEmail     String
  groups        String // JSON string[] snapshot at review start
  roles         String // JSON string[] snapshot at review start
  lastLoginAt   DateTime?
  stale         Boolean      @default(false) // no sign-in for 30+ days at review start
  decision      String? // keep | revoke
  note          String?
  decidedById   String?
  decidedByName String?
  decidedAt     DateTime?

  @@unique([reviewId, userId])
  @@index([reviewId, decision])
}

// Chargebacks tool. A card dispute against a transaction. Statuses:
// open (unassigned) -> in_progress (picked up) -> won | lost | written_off.
// A lost dispute over the write-off threshold stays "lost" until finance
// approves the write-off. customerEmail is denormalized for display and is
// PII (masked for users without pii:read).
model Dispute {
  id             String    @id
  transactionId  String
  customerId     String
  customerEmail  String
  amountCents    Int
  currency       String    @default("USD")
  merchant       String
  cardLast4      String
  network        String // visa | mastercard
  reasonCode     String // fraud | not_received | not_as_described | duplicate | canceled_subscription | other
  status         String // open | in_progress | won | lost | written_off
  assignedToId   String?
  assignedToName String?
  assignedAt     DateTime?
  evidenceNote   String?
  evidenceAt     DateTime?
  openedAt       DateTime
  respondBy      DateTime
  resolvedAt     DateTime?
  writtenOffAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, respondBy])
  @@index([customerId])
  @@index([transactionId])
  @@index([resolvedAt])

// "Build with Devin" request center. A plain-language request for a new tool
// or a change, approved by an admin, then built by a Devin session.
model ToolRequest {
  id                String    @id @default(cuid())
  kind              String // new_tool | change_tool
  toolSlug          String? // target tool for change_tool (or the new tool's slug once known)
  title             String
  problem           String
  audienceGroups    String // JSON string[] of IdP groups
  workflow          String // what people need to do
  signOff           String?
  signOffAboveCents Int?
  involvesPii       Boolean   @default(false)
  movesMoney        Boolean   @default(false)
  peopleCount       Int?
  hoursPerWeek      Float? // team hours per week spent on this today
  prompt            String // exactly what Devin receives
  status            String    @default("submitted") // submitted | ready_simulation | building | pr_open | merged | launch_failed
  mode              String? // live | simulation, set at launch
  requestedById     String
  requestedByName   String
  approvalRequestId String?   @unique
  devinSessionId    String?
  devinSessionUrl   String?
  devinStatus       String?
  simulatedPayload  String? // JSON request body shown in simulation mode
  prUrl             String?
  prState           String? // open | merged | closed
  acusUsed          Float?
  launchedAt        DateTime?
  lastSyncedAt      DateTime?
  shippedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([requestedById, createdAt])
  @@index([status, createdAt])
}
